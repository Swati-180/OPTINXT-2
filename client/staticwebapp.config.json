{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/assets/*", "/src/*", "*.css", "*.js", "*.ico", "*.png", "*.svg", "*.json", "*.woff", "*.woff2", "*.ttf"]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  }
}
