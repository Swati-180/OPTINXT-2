# BACKEND ENVIRONMENT VARIABLES
# Copy to server/.env and replace placeholders with real values.
# Do not commit server/.env to source control.

# --- Core Server Configuration ---
PORT=5000
NODE_ENV=development

# --- Database ---
# For local development: mongodb://localhost:27017/optinxt_payroll_db
# For production (Sparsh must replace with actual MongoDB Atlas URI):
MONGODB_URI=mongodb://localhost:27017/optinxt_payroll_db

# --- Security ---
# Secret key for signing JWT tokens
JWT_SECRET=change_me_to_a_strong_secret

# --- CORS & URLs ---
# Public frontend URL (used for email links)
FRONTEND_URL=http://localhost:3001
# Allowed origin for CORS (set to the deployed frontend URL, e.g. https://payroll.optinxt.com)
CORS_ORIGIN=http://localhost:3001

# --- Email Configuration (Required for Invites/WDT) ---
# Gmail credentials for sending emails
GMAIL_USER=your_production_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# --- External APIs ---
# HuggingFace token for AI Taxonomy processing (if applicable)
HF_TOKEN=your_huggingface_token
